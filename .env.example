# 🛠️ Dijital Ustabaşı Çevre Değişkenleri Şablonu (.env.example)

# Veri Saklama ve Veritabanı Dizini (Opsiyonel, Varsayılan: storage)
STORAGE_DIR=storage

# Yönetici Güvenlik Anahtarı (Admin Panel ve API Yetkilendirme)
ADMIN_KEY=ustabasi2026

# Yapay Zeka Servis Anahtarları (Google AI Studio Gemini & OpenAI Whisper)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Sunucu Port Değeri (Railway / Uvicorn)
PORT=8080

# Meta WhatsApp Business Cloud API Yapılandırması
WHATSAPP_TOKEN=your_whatsapp_business_permanent_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=ustabasi_verify_secret_2026

